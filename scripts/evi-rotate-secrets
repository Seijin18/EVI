#!/usr/bin/env bash
# Rotate default/static secrets (EVOLUTION_API_KEY, POSTGRES_PASSWORD, WINDMILL_DB_PASSWORD,
# NEO4J_PASSWORD, QDRANT__SERVICE__API_KEY). Dry-run by default; --apply performs it
# (backup -> change in services -> rewrite .env -> recreate -> verify).
# Usage: scripts/evi-rotate-secrets [--apply] [--only NAME[,NAME]]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="${ROOT}/agent:${PYTHONPATH:-}"
PY="${ROOT}/.venv/bin/python"
[ -x "$PY" ] || PY=python3
exec "$PY" -m testing.rotate_secrets --root "$ROOT" "$@"
