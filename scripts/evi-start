#!/usr/bin/env bash
# Sobe o sistema EVI inteiro: confere o host, sobe a stack Docker, espera cada serviço
# ficar saudável, liga o watchdog e mostra o que ainda precisa de atenção.
#
#   ./scripts/evi-start              sobe tudo e mostra o resumo
#   ./scripts/evi-start --check      só verifica (não sobe nem altera nada)
#   ./scripts/evi-start --graph      inclui o Neo4j (profile `graph`)
#   ./scripts/evi-start --no-watchdog  não liga o timer do watchdog
#   ./scripts/evi-start --wait 180   espera máxima pela saúde, em segundos (padrão 120)
#
# Códigos de saída: 0 tudo certo · 2 subiu, mas há avisos · 1 falha (não subiu / pré-requisito faltando).
# Idempotente: rodar de novo com tudo no ar não muda nada. Nunca imprime segredos do .env.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

ENV_FILE="${EVI_ENV_FILE:-$ROOT/.env}"
API_URL="${EVI_API_URL:-http://127.0.0.1:8002}"
EVO_URL="${EVI_EVOLUTION_URL:-http://127.0.0.1:8082}"
WMILL_URL="${EVI_WINDMILL_URL:-http://127.0.0.1:8001}"
BRIDGE_IP="${EVI_DOCKER_BRIDGE_IP:-172.17.0.1}"
WATCHDOG="evi-watchdog.timer"

CHECK_ONLY=0 GRAPH=0 WATCHDOG_ON=1 WAIT_SEC=120
while (( $# )); do
  case "$1" in
    --check) CHECK_ONLY=1 ;;
    --graph) GRAPH=1 ;;
    --no-watchdog) WATCHDOG_ON=0 ;;
    --wait) shift; WAIT_SEC="${1:-120}" ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "opção desconhecida: $1 (use --help)" >&2; exit 1 ;;
  esac
  shift
done

if [[ -t 1 ]]; then R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' B=$'\e[1m' N=$'\e[0m'; else R= G= Y= B= N=; fi
WARNINGS=()
say()  { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; WARNINGS+=("$*"); }
die()  { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# Lê uma variável do .env sem fazer source e sem imprimir o valor.
envval() { grep -m1 "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"; }
has_env() { [[ -n "$(envval "$1")" ]]; }

COMPOSE=(docker compose)
(( GRAPH )) && COMPOSE+=(--profile graph)

# ---------------------------------------------------------------- 1. pré-requisitos do host
say "Conferindo o host"
command -v docker >/dev/null 2>&1 || die "docker não está instalado."
docker info >/dev/null 2>&1 || die "o daemon do Docker não responde. Tente: sudo systemctl start docker"
ok "Docker ativo"

[[ -f "$ENV_FILE" ]] || die ".env não encontrado em $ENV_FILE (copie .env.example e preencha)."
perm="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || echo ?)"
[[ "$perm" == "600" ]] && ok ".env presente (modo 600)" || warn ".env com modo $perm: rode chmod 600 $ENV_FILE (guarda segredos)"

missing=()
for k in POSTGRES_PASSWORD WINDMILL_DB_PASSWORD EVOLUTION_API_KEY EVI_API_KEY QDRANT__SERVICE__API_KEY; do
  has_env "$k" || missing+=("$k")
done
if [[ "$(envval TELEGRAM_MODE)" == "polling" || -n "$(envval TELEGRAM_BOT_TOKEN)" ]]; then
  for k in TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID; do has_env "$k" || missing+=("$k"); done
fi
if grep -qiE '^(EVI_LLM_PROVIDER|EVI_EMBED_PROVIDER)=(gemini|google)' "$ENV_FILE" 2>/dev/null; then
  has_env GEMINI_API_KEY || missing+=("GEMINI_API_KEY")
fi
if (( ${#missing[@]} )); then
  die "variáveis obrigatórias ausentes/vazias no .env: ${missing[*]}"
fi
ok "variáveis obrigatórias do .env presentes"
has_env OPENROUTER_API_KEY || warn "OPENROUTER_API_KEY vazia: juízes de dívida/tarefa/promessa ficam sem LLM (usam o fallback seguro)"

if grep -qiE '^EVI_[A-Z_]*PROVIDER=ollama' "$ENV_FILE" 2>/dev/null; then
  if curl -s -m 3 -o /dev/null "http://$BRIDGE_IP:11434/api/version"; then
    ok "Ollama responde em $BRIDGE_IP:11434"
  else
    warn "Ollama configurado como provedor mas não responde em $BRIDGE_IP:11434 (sudo systemctl start ollama; ./scripts/evi-host-hardening ollama)"
  fi
fi

free_gb=$(df -BG --output=avail "$ROOT" 2>/dev/null | tail -1 | tr -dc '0-9')
[[ -n "${free_gb:-}" && "$free_gb" -lt 5 ]] && warn "pouco espaço em disco: ${free_gb} GB livres (volumes do Postgres/Qdrant crescem)"

running_api="$(docker compose ps -q agent-api 2>/dev/null | head -1)"
if [[ -z "$running_api" ]] && (( ! CHECK_ONLY )); then
  for p in 8001 8002 8082; do
    ss -ltnH "sport = :$p" 2>/dev/null | grep -q . && warn "porta $p já está em uso por outro processo (a stack não vai conseguir publicar nela)"
  done
fi

# ---------------------------------------------------------------- 2. subir a stack
if (( CHECK_ONLY )); then
  say "Modo --check: nada será iniciado"
else
  say "Subindo a stack (docker compose up -d)"
  if ! "${COMPOSE[@]}" up -d; then
    "${COMPOSE[@]}" ps -a --format 'table {{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null
    die "docker compose up falhou (veja a saída acima; docker compose logs <serviço>)."
  fi
fi

# ---------------------------------------------------------------- 3. esperar saúde
mapfile -t SERVICES < <("${COMPOSE[@]}" config --services 2>/dev/null)
stack_state() {  # imprime "serviço estado saúde" para cada serviço esperado (respeita --graph)
  local svc id
  for svc in "${SERVICES[@]}"; do
    id="$("${COMPOSE[@]}" ps -a -q "$svc" 2>/dev/null | head -1)"
    if [[ -z "$id" ]]; then echo "$svc sem-container -"; continue; fi
    docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}} {{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}' "$id"
  done
}
stack_ready() {
  local out; out="$(stack_state)"
  [[ -n "$out" ]] && ! awk '$2!="running" || ($3!="-" && $3!="healthy"){bad=1} END{exit !bad}' <<<"$out"
}

if (( CHECK_ONLY )); then
  say "Estado dos serviços"
else
  say "Esperando os serviços ficarem saudáveis (até ${WAIT_SEC}s)"
  deadline=$((SECONDS + WAIT_SEC))
  until stack_ready; do
    if (( SECONDS >= deadline )); then break; fi
    sleep 3
  done
fi
while read -r svc st hl; do
  [[ -z "$svc" ]] && continue
  if [[ "$st" == running && ( "$hl" == "-" || "$hl" == healthy ) ]]; then ok "$svc ($st${hl:+ / $hl})"
  else warn "$svc: estado=$st saúde=$hl (docker compose logs $svc --tail 50)"; fi
done < <(stack_state)
if ! stack_ready && (( ! CHECK_ONLY )); then warn "nem todos os serviços ficaram saudáveis em ${WAIT_SEC}s"; fi

# ---------------------------------------------------------------- 4. watchdog
if (( WATCHDOG_ON && ! CHECK_ONLY )); then
  say "Watchdog"
  if systemctl --user cat "$WATCHDOG" >/dev/null 2>&1; then
    systemctl --user start "$WATCHDOG" && ok "watchdog ligado (avisa no Telegram se o EVI cair)"
  else
    warn "watchdog não instalado (ver docs/operations.md: cp scripts/systemd/evi-watchdog.* ~/.config/systemd/user/ && systemctl --user enable --now $WATCHDOG)"
  fi
elif (( CHECK_ONLY )); then
  state="$(systemctl --user is-active "$WATCHDOG" 2>/dev/null || true)"
  [[ "$state" == active ]] && ok "watchdog ativo" || warn "watchdog não está ativo (estado: ${state:-não instalado})"
fi

# ---------------------------------------------------------------- 5. o que o EVI enxerga
say "Saúde do EVI"
health_json="$(curl -s -m 15 "$API_URL/health" 2>/dev/null || true)"
if [[ -z "$health_json" ]]; then
  warn "agent-api não respondeu em $API_URL/health"
else
  summary="$(python3 - "$health_json" <<'PY' 2>/dev/null
import json, sys
try:
    d = json.loads(sys.argv[1])
except Exception:
    print("invalid"); raise SystemExit
bad = [k for k, v in (d.get("checks") or {}).items() if isinstance(v, dict) and v.get("ok") is False]
print(f"{d.get('status','?')}|{','.join(bad)}")
PY
)"
  st="${summary%%|*}"; bad="${summary#*|}"
  if [[ "$st" == ok ]]; then ok "/health: ok"
  else warn "/health: ${st:-inválido}${bad:+ — verificações com falha: $bad}"; fi
fi

evo_key="$(envval EVOLUTION_API_KEY)"; inst="$(envval EVOLUTION_INSTANCE_NAME)"; inst="${inst:-evi}"
wa_state="$(curl -s -m 8 -K - "$EVO_URL/instance/connectionState/$inst" 2>/dev/null <<<"header = \"apikey: $evo_key\"" \
  | python3 -c "import json,sys;print(json.load(sys.stdin)['instance']['state'])" 2>/dev/null || true)"
case "$wa_state" in
  open) ok "WhatsApp conectado" ;;
  "")   warn "Evolution não respondeu: não deu para checar o WhatsApp" ;;
  *)    warn "WhatsApp desconectado (estado: $wa_state): abra $EVO_URL/manager, gere o QR e escaneie em Aparelhos conectados" ;;
esac

if [[ "$(envval TELEGRAM_MODE)" == "polling" ]]; then
  # Logo depois de subir, o log "poller started" pode demorar alguns segundos: tenta de novo.
  tries=1; (( ! CHECK_ONLY )) && tries=8
  poller=0
  for ((i = 0; i < tries; i++)); do
    started="$(docker inspect -f '{{.State.StartedAt}}' "$("${COMPOSE[@]}" ps -q agent-api | head -1)" 2>/dev/null || true)"
    if [[ -n "$started" ]] && "${COMPOSE[@]}" logs --since "$started" agent-api 2>/dev/null | grep -q "Telegram poller started"; then poller=1; break; fi
    (( i < tries - 1 )) && sleep 3
  done
  (( poller )) && ok "Telegram (long polling) ativo" \
    || warn "Telegram poller não confirmado nos logs (docker compose logs agent-api | grep -i telegram)"
fi

code="$(curl -s -m 5 -o /dev/null -w '%{http_code}' "$WMILL_URL/api/version" 2>/dev/null || true)"
[[ "$code" == 200 ]] && ok "Windmill respondendo" || warn "Windmill não respondeu em $WMILL_URL (HTTP ${code:-000})"

# ---------------------------------------------------------------- resumo
echo
if (( ${#WARNINGS[@]} )); then
  printf '%sEVI no ar, com %d aviso(s):%s\n' "$Y" "${#WARNINGS[@]}" "$N"
  printf '  - %s\n' "${WARNINGS[@]}"
  exit 2
fi
printf '%sEVI no ar e saudável.%s  Status detalhado: make status · logs: make logs\n' "$G" "$N"
