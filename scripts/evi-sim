#!/usr/bin/env bash
# EVI simulation harness CLI. Subcommands: guard | up | down | run | report
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
PY="${ROOT}/.venv/bin/python"
[[ -x "$PY" ]] || PY="python3"

DC=(docker compose -p evi-sim --env-file /dev/null -f "${ROOT}/docker-compose.sim.yml")

_guard() { PYTHONPATH="${ROOT}/agent" "$PY" -m testing.sim.guard; }

_load_gemini_key() {
  if [[ -n "${EVI_SIM_GEMINI_API_KEY:-}" ]]; then
    return
  fi
  local line=""
  [[ -f "${ROOT}/.env" ]] && line="$(grep -m1 '^GEMINI_API_KEY=' "${ROOT}/.env" || true)"
  line="${line#GEMINI_API_KEY=}"
  line="${line%\"}"; line="${line#\"}"; line="${line%\'}"; line="${line#\'}"
  if [[ -n "$line" ]]; then
    echo "evi-sim: using production GEMINI_API_KEY (EVI_SIM_GEMINI_API_KEY not set)" >&2
    export EVI_SIM_GEMINI_API_KEY="$line"
  else
    echo "evi-sim: no Gemini key found (set EVI_SIM_GEMINI_API_KEY); LLM calls will fail" >&2
  fi
}

_wait_healthy() {
  local deadline=$((SECONDS + 120)) svc
  for svc in postgres fakes agent-api; do
    until [[ "$("${DC[@]}" ps --format '{{.Health}}' "$svc" 2>/dev/null)" == "healthy" ]]; do
      if (( SECONDS >= deadline )); then
        echo "evi-sim: $svc did not become healthy" >&2
        "${DC[@]}" ps >&2 || true
        return 1
      fi
      sleep 2
    done
  done
}

# --llm live|record|replay (anywhere in the args of `run`/`up`) selects the agent's provider.
# replay never needs (nor receives) a Gemini key.
LLM_MODE="live"
_args=("$@")
for ((i = 0; i < ${#_args[@]}; i++)); do
  case "${_args[$i]}" in
    --llm) LLM_MODE="${_args[$((i + 1))]:-live}" ;;
    --llm=*) LLM_MODE="${_args[$i]#--llm=}" ;;
  esac
done
case "$LLM_MODE" in
  live) export EVI_SIM_LLM_PROVIDER=gemini ;;
  record) export EVI_SIM_LLM_PROVIDER=sim-record ;;
  replay) export EVI_SIM_LLM_PROVIDER=sim-replay; unset EVI_SIM_GEMINI_API_KEY ;;
  *) echo "evi-sim: --llm must be live|record|replay" >&2; exit 64 ;;
esac

cmd="${1:-}"
shift || true
case "$cmd" in
  guard)
    _guard
    ;;
  up)
    _guard
    [[ "$LLM_MODE" == replay ]] || _load_gemini_key
    if ! docker image inspect evi-agent-api:latest >/dev/null 2>&1; then
      echo "evi-sim: base image evi-agent-api:latest missing, building it" >&2
      docker build -t evi-agent-api:latest "${ROOT}/agent"
    fi
    "${DC[@]}" up -d --build
    _wait_healthy
    echo "evi-sim: up (agent-api http://127.0.0.1:18000, fakes http://127.0.0.1:18080)"
    ;;
  down)
    "${DC[@]}" down -v --remove-orphans
    ;;
  run)
    # `up` is idempotent: compose recreates agent-api when the LLM mode (env) or code changed.
    "$0" up --llm "$LLM_MODE"
    PYTHONPATH="${ROOT}/agent" "$PY" -m testing.sim.runner run "$@"
    ;;
  report)
    PYTHONPATH="${ROOT}/agent" "$PY" -m testing.sim.runner report "$@"
    ;;
  *)
    echo "usage: evi-sim {guard|up|down|run|report}" >&2
    exit 64
    ;;
esac
