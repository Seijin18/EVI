# evi-sim: ALL runtime env for the simulation stack. Versioned, NO secrets.
# The only secret (the LLM key) is forwarded by scripts/evi-sim via
# EVI_SIM_GEMINI_API_KEY; nothing from ./.env is ever read by compose.
EVI_SIM=1
EVI_LLM_PROVIDER=gemini
EVI_BACKGROUND_LLM_PROVIDER=gemini
EVI_EMBED_PROVIDER=ollama
GEMINI_MODEL=gemini-2.5-flash
# No hidden reasoning tokens (billed as output): the sim measures behaviour, not deep thinking
EVI_GEMINI_THINKING_BUDGET=0
EVI_ORCHESTRATOR=windmill
EVI_WHATSAPP_PROVIDER=evolution
EVI_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Fake Telegram Bot API (served by the `fakes` container)
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=sim-token
TELEGRAM_CHAT_ID=900000001
TELEGRAM_API_BASE=http://fakes:18080

# Fake Evolution API
EVOLUTION_SERVER_URL=http://fakes:18080
EVOLUTION_API_KEY=sim-evolution-key
EVOLUTION_INSTANCE_NAME=sim
EVI_WHATSAPP_CONTROL_JIDS=5500000000001@s.whatsapp.net

# Fake Windmill (Google integrations)
WINDMILL_TOKEN=sim-windmill-token
WINDMILL_CALENDAR_ID=primary
WINDMILL_WEBHOOK_CALENDAR=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/schedule_event
WINDMILL_WEBHOOK_LIST_EVENTS=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/list_events
WINDMILL_WEBHOOK_TASKS=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/create_task
WINDMILL_WEBHOOK_LIST_TASKS=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/list_tasks
WINDMILL_WEBHOOK_EMAIL=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/summarize_inbox
WINDMILL_WEBHOOK_EMAIL_DELETE=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/delete_emails
WINDMILL_WEBHOOK_EMAIL_DELETE_QUERY=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/delete_emails_by_query
WINDMILL_WEBHOOK_EMAIL_SEARCH=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/search_emails
WINDMILL_WEBHOOK_LIST_CONTACTS=http://fakes:18080/api/w/evi/jobs/run_wait_result/p/f/integrations/list_contacts
WINDMILL_WEBHOOK_TELEGRAM=http://fakes:18080/api/w/evi/jobs/run/p/f/integrations/telegram_to_evi
EVI_WINDMILL_RETRY_ATTEMPTS=1
EVI_WINDMILL_RETRY_DELAY_SEC=0

# Disable optional subsystems that would reach real services
OLLAMA_BASE_URL=http://fakes:18080
QDRANT_URL=http://fakes:18080
NEO4J_URI=
EVI_NOTIFY_CHANNELS=telegram
EVI_METRICS_ENABLED=false
# No unscripted LLM callers: heartbeat/daily-summary/contact-learn are Windmill-cron targets
# (only run via a scenario `job` step); WhatsApp LLM extraction is opt-in and kept off.
EVI_HEARTBEAT_ENABLED=false
EVI_WHATSAPP_LLM_EXTRACT=false
EVI_REQUIRE_API_KEY=false

# Morning briefing (the `briefing` job step posts /jobs/briefing; sim only)
EVI_BRIEFING_ENABLED=true

# Reminders: in-process firing loop (reads the libfaketime clock); 5 s is the code minimum
EVI_REMINDERS_ENABLED=true
EVI_REMINDERS_TICK_SEC=5

# Container-local paths (isolated, no host binds)
EVI_WORKSPACE=/tmp/evi-sim-workspace
EVI_LOG_DIR=/tmp/evi-sim-logs
EVI_CONTACT_MEMORY_DIR=/tmp/evi-sim-contact-memory

# libfaketime: runner writes "@YYYY-MM-DD HH:MM:SS" into /sim/clock
FAKETIME_TIMESTAMP_FILE=/sim/clock
FAKETIME_NO_CACHE=1

# Sim postgres
DATABASE_URL=postgresql://evisim:evisim@postgres:5432/evisim

# Reply debts: promises, dated-only commitments, briefing groups, no per-capture notifications
EVI_REPLY_DEBTS_ENABLED=true
EVI_REPLY_DEBT_HOURS=4

# Voice input (evi-voice-input): transcription by the real Gemini (live) or cassette (replay)
EVI_VOICE_ENABLED=true

# Perceived reliability: "⏳ fazendo…" after 3 s of a slow tool (SIM-REL-03 uses a 8 s Windmill fault)
EVI_SLOW_ACK_SEC=3

# Promise context (SCN-DEBT-10/11/15): background evaluation of the user's promises.
# Delay 10 min of SIM clock; the loop sweeps every 5 s real time. The structured call goes to the
# real OpenRouter (live/record; key forwarded by scripts/evi-sim) or to the cassette (replay).
EVI_PROMISE_CONTEXT_ENABLED=true
EVI_PROMISE_EVAL_DELAY_MIN=10
EVI_PROMISE_EVAL_TICK_SEC=5
EVI_LLM_TASK_DAILY_USD=0.50

# Contact names (evi-contact-names): address-book sync via the fake People API; the weekly
# "Conversas sem nome" hint is a structured call (live: OpenRouter; record/replay: cassette).
EVI_CONTACT_NAMES_SYNC_ENABLED=true
