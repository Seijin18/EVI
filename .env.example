POSTGRES_DB=evidb
POSTGRES_USER=evi
# Secrets below are placeholders: docker-compose.yml refuses to start without them.
# For a fresh install run `scripts/evi-rotate-secrets --apply` to generate real ones
# (also the procedure to rotate them later, see docs/security.md).
POSTGRES_PASSWORD=CHANGE_ME_run_scripts/evi-rotate-secrets
WINDMILL_DB_USER=windmill
WINDMILL_DB_PASSWORD=CHANGE_ME_run_scripts/evi-rotate-secrets
# ── LLM provider ─────────────────────────────────────────────────────────────
# EVI_LLM_PROVIDER   = ollama (default) | gemini | openai | anthropic
# EVI_EMBED_PROVIDER = ollama (default) | google | openai
EVI_LLM_PROVIDER=ollama
# Background tasks (extract, summaries, contact learn) — default ollama even when chat uses gemini
# EVI_BACKGROUND_LLM_PROVIDER=ollama
EVI_EMBED_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
# Gemini (EVI_LLM_PROVIDER=gemini or EVI_EMBED_PROVIDER=google)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Thinking budget (tokens) for Gemini 2.5. Thinking is billed as OUTPUT ($2.50/1M on flash),
# so it dominates cost. 0 disables thinking; a positive int caps it; unset keeps the model default.
# EVI_GEMINI_THINKING_BUDGET=0
# EVI_LLM_TIMEOUT_SEC=30  # per Gemini attempt
# EVI_LLM_MAX_RETRIES=2   # retries after a failed/timed-out attempt (library default is 6)
# GEMINI_EMBED_MODEL=models/gemini-embedding-001
# OpenAI (EVI_LLM_PROVIDER=openai or EVI_EMBED_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# Anthropic (EVI_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-3-5-haiku-20241022
# ─────────────────────────────────────────────────────────────────────────────
# Orchestration backend (EVI_ORCHESTRATOR=windmill is the only shipped backend)
EVI_ORCHESTRATOR=windmill
# WhatsApp messaging backend (EVI_WHATSAPP_PROVIDER=evolution is the only shipped backend)
EVI_WHATSAPP_PROVIDER=evolution
QDRANT_URL=http://qdrant:6333
# Qdrant auth (the agent reads the same value as QDRANT_API_KEY). Set by
# `scripts/evi-rotate-secrets`. Never leave it present-but-empty: an empty value makes
# Qdrant enable auth with an empty key and reject every request with 401.
# QDRANT__SERVICE__API_KEY=CHANGE_ME_run_scripts/evi-rotate-secrets
# Host-side URL for local scripts/psql. Host port is 5433 (5432 is taken by
# an unrelated container); inside compose the agent uses postgres:5432.
DATABASE_URL=postgresql://evi:CHANGE_ME_run_scripts/evi-rotate-secrets@localhost:5433/evidb

# Bearer for Windmill jobs (Account settings → Tokens); not Google OAuth
# WINDMILL_TOKEN=
# Retry Windmill 401/422 once (OAuth resource refresh on cold start)
EVI_WINDMILL_RETRY_ATTEMPTS=2
EVI_WINDMILL_RETRY_DELAY_SEC=2
# Windmill resource path for Calendar OAuth (e.g. u/you/well_educated_gcal)
# WINDMILL_GCAL_RESOURCE=u/you/gcal
# Google Contacts (People API, contacts.readonly) — ver windmill/README.md
# WINDMILL_GCONTACTS_RESOURCE=u/you/gcontacts
# Calendar display name (EVI) or API id (primary, or …@group.calendar.google.com)
# WINDMILL_CALENDAR_ID=EVI
# IANA timezone for Calendar events (wall clock, not UTC)
# EVI_TIMEZONE=America/Sao_Paulo

# JSONL logs (telegram, evolution) — keep entries up to N days
# EVI_LOG_MAX_AGE_DAYS=7
# EVI_LOG_MAX_LINES=5000
# EVI_HARNESS_LOG_MAX_AGE_DAYS=1
# Google Tasks — resource Windmill tipo gtasks (NÃO usar gcloud; ver windmill/README.md)
# WINDMILL_GTASKS_RESOURCE=u/you/evi_tasks
# Gmail via Windmill gmail OAuth. See windmill/README.md
# WINDMILL_GMAIL_RESOURCE=u/you/gmail
# WINDMILL_WEBHOOK_EMAIL_DELETE=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/delete_emails
# WINDMILL_WEBHOOK_EMAIL_DELETE_QUERY=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/delete_emails_by_query
# WINDMILL_WEBHOOK_EMAIL_SEARCH=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/search_emails

# Cloudflare named tunnel (free) — stable Telegram webhook hostname
# CLOUDFLARE_TUNNEL_NAME=evi-windmill
# CLOUDFLARE_TUNNEL_HOSTNAME=wm.example.com

# Telegram — polling (recommended home): no tunnel/domain. webhook = Windmill+tunnel
# TELEGRAM_MODE=polling
# TELEGRAM_BOT_TOKEN=from @BotFather
# TELEGRAM_CHAT_ID= numeric chat.id from getUpdates (digest + sendMessage default)
# Only this chat (plus TELEGRAM_ALLOWED_CHAT_IDS) can talk to EVI; others are ignored.
# TELEGRAM_ALLOWED_CHAT_IDS=  # optional extra chat ids; ONLY works together with TELEGRAM_CHAT_ID (empty owner = every chat rejected)
# Setup polling: ./scripts/evi-telegram-polling-setup.sh
# TELEGRAM_API_BASE=https://api.telegram.org  # only for simulation (fake Bot API); leave unset in production
# Async URL from script Triggers — optional ?token=… if WINDMILL_TOKEN unset
WINDMILL_WEBHOOK_CALENDAR=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/schedule_event
WINDMILL_WEBHOOK_LIST_EVENTS=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/list_events
WINDMILL_WEBHOOK_TASKS=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/create_task
WINDMILL_WEBHOOK_LIST_TASKS=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/list_tasks
WINDMILL_WEBHOOK_EMAIL=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/summarize_inbox
WINDMILL_WEBHOOK_TELEGRAM=http://windmill-server:8000/api/w/evi/jobs/run/p/f/integrations/telegram_to_evi

EVOLUTION_API_KEY=CHANGE_ME_run_scripts/evi-rotate-secrets
# Host/scripts (setup-evolution.sh). agent-api no compose usa http://evolution-api:8080
EVOLUTION_SERVER_URL=http://localhost:8082
EVOLUTION_INSTANCE_NAME=evi
EVOLUTION_WEBHOOK_URL=http://agent-api:8000/webhooks/evolution

# EVI agent runtime v3 (OpenClaw-inspired)
EVI_WORKSPACE=/home/marshibs/Projects/EVI/EVI_WORKSPACE
# EVI_DIRECT_HANDLERS=false
# EVI_HEARTBEAT_ENABLED=false
# EVI_CONTACT_LEARN_NOTIFY=false
# Lembretes: loop de disparo dentro do agent-api (ligue para receber lembretes no Telegram)
EVI_REMINDERS_ENABLED=false
# Intervalo do loop de lembretes em segundos (mínimo 5)
EVI_REMINDERS_TICK_SEC=30
# Briefing diário no Telegram via POST /jobs/briefing (agendado no Windmill)
EVI_BRIEFING_ENABLED=false
# Reply debts: liga promessas do usuário, compromissos só com data, grupos no briefing e
# silencia a notificação avulsa de captura (default false)
EVI_REPLY_DEBTS_ENABLED=false
# Idade mínima (horas) de uma mensagem sem resposta para virar pendência (default 4)
EVI_REPLY_DEBT_HOURS=4
# Máximo de e-mails "acionáveis" listados no briefing
EVI_BRIEFING_EMAIL_MAX=3
# Voice input: transcribe the user's voice notes (Telegram chat + WhatsApp control chat)
# with Gemini and handle them as text; the reply echoes "Entendi: ...". Requires
# EVI_LLM_PROVIDER=gemini (ollama replies that audio is unsupported). Default false.
EVI_VOICE_ENABLED=false
# Longest accepted voice note in seconds; longer ones get a short "too long" reply
EVI_VOICE_MAX_SECONDS=300
# Slow-tool ack: if a tool in a Telegram/control-chat turn runs longer than this many
# seconds, send "⏳ fazendo…" once per turn. 0 = off (default); 5 is a good value.
EVI_SLOW_ACK_SEC=0

# WhatsApp webhook filters (agent-api)
EVI_WHATSAPP_MAX_PER_WEBHOOK=10
EVI_WHATSAPP_MAX_AGE_HOURS=24
EVI_WHATSAPP_REQUIRE_TS=true
# EVI_WHATSAPP_PROCESS_AFTER=2026-06-17T05:00:00+00:00
EVI_WHATSAPP_INCOMING_ONLY=true
EVI_WHATSAPP_SKIP_GROUPS=true
# Com whitelist, só estes JIDs de grupo (@g.us) passam; demais grupos ignorados.
# Requer groupsIgnore=false na Evolution — rode ./scripts/setup-evolution.sh após definir.
# EVI_WHATSAPP_GROUP_WHITELIST=120363012345678901@g.us,120363098765432109@g.us
EVI_WHATSAPP_DEDUPE_IDS=true
# Backfill de histórico para learn_whatsapp_contact (Evolution findMessages)
EVI_BACKFILL_MAX_MESSAGES=200
EVI_BACKFILL_INCLUDE_FROM_ME=true
EVI_EVOLUTION_DISCOVER_CONTACTS=true
# Teto da descoberta de contatos da Evolution. 300 cortava a maioria das
# agendas reais (2553 contatos neste setup); 3000 cobre com folga.
EVI_EVOLUTION_CONTACTS_LIMIT=3000
EVI_WHATSAPP_RECENT_MAX_CHATS=30
EVI_WHATSAPP_RECENT_MSG_PER_CHAT=15
# Replay evolution_webhook.jsonl ao listar compromissos (recupera msgs perdidas na ingestão)
EVI_COMMITMENT_REPLAY_ON_LIST=true
EVI_COMMITMENT_REPLAY_DAYS=14
# LLM fallback when heuristic extract returns nothing (requires Ollama)
# EVI_WHATSAPP_LLM_EXTRACT=false
# EVI_WHATSAPP_LLM_MIN_CONFIDENCE=0.6
# EVI_WHATSAPP_LLM_TIMEOUT_SEC=30
# Chat de comando EVI (grupo solo ou Mensagens para mim). Respostas com prefixo [EVI]
# EVI_WHATSAPP_CONTROL_JIDS=5511999999999@s.whatsapp.net
# EVI_WHATSAPP_REPLY_PREFIX=[EVI] 
# Digest/review: telegram,whatsapp (whatsapp exige CONTROL_JIDS)
EVI_NOTIFY_CHANNELS=telegram

# Prometheus exposition at GET /metrics (no prometheus container in compose)
EVI_METRICS_ENABLED=true

# Long-term memory (Etapa 5a) — cold FS per WhatsApp/Telegram JID
EVI_CONTACT_MEMORY_DIR=/data/contact_memory
# Host bind: ./data/contact_memory (compose volume on agent-api)

# Knowledge graph (Etapa 5b, optional) — docker compose --profile graph up -d neo4j
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME_run_scripts/evi-rotate-secrets

# Shared secret between EVI and its callers (Windmill telegram_to_evi, Evolution
# webhook, any public tunnel). Not obtained from a service — generate your own:
#   openssl rand -hex 32
# Required: every route except / and /health needs X-Api-Key. Windmill jobs get it
# from the worker environment (WHITELIST_ENVS); setup-evolution.sh puts it in the
# Evolution webhook headers. See docs/security.md (rotation procedure).
EVI_API_KEY=
# true = refuse to start while EVI_API_KEY is empty (keep it true).
EVI_REQUIRE_API_KEY=true
EVI_PROJECT_ROOT=/home/marshibs/Projects/EVI
EVI_API_URL=http://localhost:8002
EVI_HOST_WATCH_PREFIX=/home/marshibs/Projects/EVI/watched_folders
EVI_CONTAINER_WATCH_PREFIX=/watched_folders
EVI_NOTES_DIR=/watched_folders/inbox_ia
# Host scripts/tests; Docker agent-api always writes to ./logs (mounted as /logs)
EVI_LOG_DIR=/home/marshibs/Projects/EVI/logs

# Google OAuth (Windmill Resources)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Windmill workspace variables (UI): EVI_AGENT_URL, EVI_API_KEY for telegram_to_evi

# --- Structured LLM tasks (agent/services/llm_structured.py) ---
# OpenRouter key for structured tasks. ZDR + data_collection=deny are forced in code.
# OPENROUTER_API_KEY=
# Daily USD cap summed over all OpenRouter structured calls (America/Sao_Paulo day).
# EVI_LLM_TASK_DAILY_USD=0.10
# Per-request timeout in seconds.
# EVI_LLM_TASK_TIMEOUT_SEC=30
# Per task (TASK upper-case): provider = openrouter | ollama | gemini.
# EVI_LLM_TASK_PROMISE_PROVIDER=openrouter
# Comma-separated list = model fallback within the same provider.
# EVI_LLM_TASK_PROMISE_MODEL=google/gemma-4-31b-it,qwen/qwen3.8-27b
# Ollama only: true/false sent as "think" (empty = key not sent).
# EVI_LLM_TASK_PROMISE_THINK=
# Explicit opt-in fallback provider tried once after the primary fails (empty = none).
# EVI_LLM_TASK_PROMISE_FALLBACK=
